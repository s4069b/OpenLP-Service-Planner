# Public URL seen by browsers. HTTPS is required in production.
PLANNER_PUBLIC_ORIGIN=https://planner.example.org
HOST=127.0.0.1
PORT=8787
PLANNER_TRUST_PROXY=true
PLANNER_MAX_UPLOAD_MB=250
PLANNER_MAX_REQUEST_MB=10

# Data paths. The systemd example overrides PLANNER_DATA_DIR.
PLANNER_DATA_DIR=/var/lib/openlp-service-planner

# Microsoft Entra ID SSO
MICROSOFT_TENANT_ID=replace-me
MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
MICROSOFT_ALLOWED_DOMAIN=example.org

# For a fresh installation only: nominate the Microsoft user who may become
# the first Administrator. It is ignored after an enabled Administrator exists.
# Remove this value after the first Administrator has signed in successfully.
PLANNER_BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# Optional ChurchSuite
CHURCHSUITE_CLIENT_ID=
CHURCHSUITE_CLIENT_SECRET=

# One-time first-Administrator setup. Use a long random value, open /setup,
# create the first local Administrator, then remove this setting.
PLANNER_SETUP_TOKEN=replace-with-a-long-random-secret

# Optional My ChurchSuite member sign-in (separate from ChurchSuite API sync)
CHURCHSUITE_OIDC_CLIENT_ID=
CHURCHSUITE_OIDC_CLIENT_SECRET=

# Emergency Administrator recovery. Leave empty normally. Set a long random
# temporary value only while using /admin-recovery, then remove it and restart.
PLANNER_ADMIN_RECOVERY_TOKEN=
