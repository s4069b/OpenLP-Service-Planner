{
  "manifest_version": 3,
  "name": "SongSelect \u2192 OpenLP Service Planner",
  "version": "1.3.0",
  "description": "Send authorised SongSelect lyrics into the OpenLP Service Planner.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://songselect.ccli.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://songselect.ccli.com/*"
      ],
      "js": [
        "songselect-content.js"
      ],
      "css": [
        "songselect-content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_page": "options.html"
}
